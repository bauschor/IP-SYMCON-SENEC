{
    "elements":
    [
        { "type": "ExpansionPanel", "caption": "Einstellungen für die SENEC API",
            "items": [
                { "type": "ValidationTextBox", "name": "SENEC_API_Username", "caption": "Username für mein-senec.de" },
                { "type": "ValidationTextBox", "name": "SENEC_API_Password", "caption": "Passwort for mein-senec.de" },
                { "type": "NumberSpinner", "name": "SENEC_API_Data_Update_Interval", "caption": "API Updatezyklus (Minuten); 0 = niemals" }
            ]
        },
        { "type": "ExpansionPanel", "caption": "Einstellungen für den lokalen Zugriff auf den SENEC Speicher",
            "items": [
                { "type": "ValidationTextBox", "name": "SENEC_Local_IP", "caption": "IP-Adresse des lokalen SENEC Moduls" },
                { "type": "ValidationTextBox", "name": "SENEC_Local_Query", "caption": "JSON-Request an das lokale SENEC Modul", "width": "900px" , "multiline": "true"},        
                { "type": "NumberSpinner", "name": "SENEC_Local_Data_Update_Interval", "caption": "lokaler Updatezyklus (Sekunden); 0 = niemals" }
            ]
        },
        { "type": "PopupAlert", "name": "InfoPopup", "visible": false,
            "popup": {
                "items": [
                    { "type": "Label", "name": "InfoPopup_Text", "caption": "Hi" }
                ]
            }
        }
    ],
    "actions":
    [
        { "type": "Button", "label": "API-Token holen", "onClick": "echo(SENEC_API_GetToken($id));" },
        { "type": "Button", "label": "Anlagen-ID abfragen", "onClick": "echo(SENEC_API_GetID($id));" },
        { "type": "Button", "label": "Anlagen-Infos per SENEC API holen", "onClick": "echo(SENEC_API_GetTechnicalInfos($id));" },        
        { "type": "Button", "label": "Live-Daten per SENEC API holen", "onClick": "echo(SENEC_API_GetData($id));" },
        { "type": "Button", "label": "Archivdaten für dieses Jahr per SENEC API holen", "onClick": "echo(SENEC_API_GetMeasurements($id));" },
        { "type": "Button", "label": "Live-Daten lokal vom SENEC Gerät einlesen", "onClick": "echo(SENEC_LOCAL_GetData($id));" },

        { "type": "ExpansionPanel", "caption": "Ladeverhalten manuell steuern",
            "items": [
                { "type": "Button", "label": "Manuelle Ladung starten", "onClick": "echo(SENEC_LOCAL_ForceCharging($id));" },
                { "type": "Button", "label": "Entladen freigeben", "onClick": "echo(SENEC_LOCAL_ProhibitCharging($id));" }
            ]
        }
    ]
}
